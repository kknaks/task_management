# 로컬 개발 env 예시. `cp .env.example .env` 후 빈 값을 채운다.
# **실제 값을 커밋하지 않는다** — .gitignore 가 `.env` 를 막는다.
# 키 이름은 SPEC-000 §5 「환경변수」 표를 따른다.

# ── docker compose 전용 ────────────────────────────────────────────────
POSTGRES_USER=tm
POSTGRES_PASSWORD=tm_local_password
POSTGRES_DB=task_management
POSTGRES_PORT=5432
API_PORT=8000

# ── 백엔드 (SPEC-000 §5) ───────────────────────────────────────────────
# 컨테이너 안에서는 compose 가 호스트를 `db` 로 덮어쓴다.
# 이 값은 호스트에서 alembic·pytest 를 직접 돌릴 때 쓰인다.
DATABASE_URL=postgresql+psycopg://tm:tm_local_password@localhost:5432/task_management

# 필수 · 기본값 없음. **비어 있으면 API 가 기동하지 않는다.**
JWT_SECRET=

# 필수 · **명시 목록**(`*` 금지). 웹 개발 origin + Tauri 앱 창 origin.
# Tauri 앱 창 origin 은 Phase 4(셸 결합)에서 실제 값으로 확정한다.
CORS_ORIGINS=http://localhost:3000,tauri://localhost,http://tauri.localhost

# 필수 · 녹음·md 저장 루트. 이 work 는 자리만 만들고 사용하지 않는다.
STORAGE_ROOT=./.storage

# 선택 (기본값은 SPEC-000 §5 표의 값)
ACCESS_TOKEN_TTL_MIN=60
REFRESH_TOKEN_TTL_DAYS=7
APP_TIMEZONE=Asia/Seoul
# 헬스 응답의 `version` 으로 그대로 나간다.
APP_VERSION=0.1.0

# ── 시드 (SPEC-000 §5 `SEED_*`) ────────────────────────────────────────
# **소스에 계정 정보를 적지 않는다.** 값은 여기서만 준다.
# SEED_PASSWORD 는 8자 이상 + 문자·숫자·특수문자여야 한다 — 위반이면 시드가 실패한다.
SEED_LOGIN_ID=kknaks
SEED_PASSWORD=dev1234!
SEED_NAME=이건학
SEED_EMAIL=

# ── 테스트 전용 ────────────────────────────────────────────────────────
# `make test` 가 쓰는 별도 DB. 실행 전에 `make test-db` 로 만든다.
TEST_DATABASE_URL=postgresql+psycopg://tm:tm_local_password@localhost:5432/task_management_test
