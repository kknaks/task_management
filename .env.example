# 로컬 개발 env 예시. `cp .env.example .env` 후 빈 값을 채운다.
# **실제 값을 커밋하지 않는다** — .gitignore 가 `.env` 를 막는다.
# 키 이름은 SPEC-000 §5 「환경변수」 표를 따른다.

# ── docker compose 전용 ────────────────────────────────────────────────
POSTGRES_USER=tm
POSTGRES_PASSWORD=tm_local_password
POSTGRES_DB=task_management
POSTGRES_PORT=5432
API_PORT=8000

# ── 백엔드 (SPEC-000 §5) ───────────────────────────────────────────────
# 컨테이너 안에서는 compose 가 호스트를 `db` 로 덮어쓴다.
# 이 값은 호스트에서 alembic·pytest 를 직접 돌릴 때 쓰인다.
DATABASE_URL=postgresql+psycopg://tm:tm_local_password@localhost:5432/task_management

# 필수 · 기본값 없음. **비어 있으면 API 가 기동하지 않는다.**
JWT_SECRET=

# 필수 · **명시 목록**(`*` 금지). 웹 개발 origin + Tauri 앱 창 origin.
# Tauri 앱 창 origin 은 Phase 4(셸 결합)에서 실제 값으로 확정한다.
CORS_ORIGINS=http://localhost:3000,tauri://localhost,http://tauri.localhost

# ── Soniox STT · 회의록 실시간 받아쓰기(SPEC-007) ──────────────────────
# 필수 · 기본값 없음. **서버에만 둔다** — 프론트로 내려가지 않는다. 비어 있으면 API 가 기동하지 않는다.
SONIOX_API_KEY=

# ── open-kknaks 브로커 · AI 워커 (BE §11) — worker 설정과 같은 값이어야 한다 ─
# 컨테이너 안에서는 compose 가 호스트를 `redis` 로 덮어쓴다. 이 값은 호스트에서 직접 돌릴 때 쓰인다(compose 가 REDIS_PORT 로 노출).
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379
# compose 의 worker 서비스도 이 두 값을 읽는다 — back 과 worker 가 같은 네임스페이스·큐를 봐야 작업이 오간다.
AI_NAMESPACE=task-management
AI_QUEUE=default
# 비우면 codex 기본 모델
AI_MODEL=
# 웜스타트 한 번의 상한(초). 배치 상한은 MEETING_BATCH_TIMEOUT_SEC(=120) 이 따로 갖는다.
AI_TIMEOUT_SEC=120

# ── 회의 배치 수치 5종 (DEC-003 §STT 확정값 · SPEC-007 §5). 실측 후 조정 — 계약은 불변 ──
# ① 미처리 확정 발화 1000자에서 배치(MF-49 — 2026-09-07 600 에서 올렸다)
MEETING_BATCH_CHARS=1000
# ② 안건 전환 시 즉시 배치 — 미처리 80자 미만이면 생략
MEETING_BATCH_SWITCH_MIN_CHARS=80
# ③ 미처리 구간이 생긴 뒤 180초 상한
MEETING_BATCH_MAX_WAIT_SEC=180
# 배치 하나의 상한 120초 — 넘으면 failed(다음 배치에 합친다)
MEETING_BATCH_TIMEOUT_SEC=120
# 회의당 AI 세션 하나(동시 실행 금지 · M-12). 항상 1
MEETING_BATCH_SESSIONS_PER_MEETING=1

# ── compose 의 open-kknaks worker (docker-compose.local.yml · system/README.md §codex 바인드 마운트) ──
# **필수(compose 기동 시)** · 호스트의 리눅스용 codex CLI 번들 디렉토리(node + @openai/codex). 컨테이너 /claude-tools 에 ro 마운트.
# 안에 `node/bin/codex`(또는 `node_modules/.bin/codex`)가 있어야 한다. 이미지에 굽지 않는다.
CODEX_TOOLS_DIR=
# **필수(compose 기동 시)** · 호스트의 codex 로그인 결과 파일. 파일 하나만 ro 로 얹는다 — 세션 디렉터리를 통째로 주지 않는다.
CODEX_AUTH_JSON=
# codex 세션 동시 실행 수. 회의당 세션 하나(M-12)라 1 이면 충분하다.
WORKER_CONCURRENCY=1

# 필수 · 녹음·md 저장 루트. 회의 녹음 원본이 `recordings/{meetingId}.*` 로 append 된다(SPEC-007 · M-13 영구 보관).
STORAGE_ROOT=./.storage

# 선택 (기본값은 SPEC-000 §5 표의 값)
ACCESS_TOKEN_TTL_MIN=60
REFRESH_TOKEN_TTL_DAYS=7
APP_TIMEZONE=Asia/Seoul
# 헬스 응답의 `version` 으로 그대로 나간다.
APP_VERSION=0.1.0

# ── 회의록 AI — MCP 서버 · 회의별 단명 토큰 (WORK-009 · MF-68 · MF-69) ──
# **필수 · 기본값 없음.** codex 가 부를 MCP 서버 주소 — 옵션 빌더가 `-c mcp_servers.tm.url` 로 싣는다.
# 비밀값은 아니지만 compose 안 주소라 기본값을 두지 않는다(틀린 주소면 codex 가 조용히 「툴 0개」로 돈다).
# compose 안: http://mcp:8010/mcp · 호스트에서 직접 돌릴 때: http://localhost:8010/mcp
MCP_SERVER_URL=http://localhost:8010/mcp
# compose 가 호스트로 노출하는 mcp 포트(도구를 직접 찔러 볼 때만 쓴다). worker 는 컨테이너 이름으로 붙는다.
MCP_PORT=8010
# `MCP_BASE_URL`(mcp 컨테이너가 부를 api 주소)은 여기 두지 않는다 — compose 가 `http://api:8000` 으로 준다.
# 호스트에서 mcp 를 직접 띄울 때만 손으로 export 한다.
# 회의별 단명 토큰 수명(분). 회의 상한 300분 + 여유. 실측 후 조정 — 계약(회의당 하나 · 원문 컬럼 · 폐기 = 행 삭제)은 불변
MEETING_TOKEN_TTL_MIN=330

# ── 시드 (SPEC-000 §5 `SEED_*`) ────────────────────────────────────────
# **소스에 계정 정보를 적지 않는다.** 값은 여기서만 준다.
# SEED_PASSWORD 는 8자 이상 + 문자·숫자·특수문자여야 한다 — 위반이면 시드가 실패한다.
SEED_LOGIN_ID=
SEED_PASSWORD=
SEED_NAME=
SEED_EMAIL=

# ── 테스트 전용 ────────────────────────────────────────────────────────
# `make test` 가 쓰는 별도 DB. 실행 전에 `make test-db` 로 만든다.
TEST_DATABASE_URL=postgresql+psycopg://tm:tm_local_password@localhost:5432/task_management_test
