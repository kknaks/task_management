# open-kknaks worker — back 이 Redis 에 제출한 AI 작업(provider=codex)을 꺼내 codex CLI 를 돌린다.
# **우리 코드가 아니다** — open-kknaks(PyPI)를 그대로 띄운다(system/README.md §Component). 여기서 정하는 것은 기동 파라미터뿐이다.
#
# codex CLI 는 **이미지에 굽지 않는다** — 호스트의 리눅스용 번들을 compose 가 `/claude-tools` 에 ro 마운트하고 `PATH` 선두에 둔다
# (open-kknaks 는 `shutil.which("codex")` 로만 찾는다). 인증(`auth.json`)도 굽지 않는다 — `CODEX_HOME` 아래로 compose 가 파일 하나만 얹는다.
# 근거: system/README.md §codex 바인드 마운트 · docker-compose.local.yml `worker`.

FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim

# ca-certificates — 마운트된 codex 가 api.openai.com 으로 HTTPS 호출할 때 필요. git — 아래 cwd 를 git 저장소로 만들 때.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git \
    && rm -rf /var/lib/apt/lists/*

# back 의 uv.lock 이 해소한 버전과 **정확히 같은 핀**(system/README.md 「back 의 핀과 worker 이미지의 핀을 같은 값으로」).
# 한쪽만 올리면 broker payload 계약이 갈린다 — 올릴 땐 app/back/pyproject.toml · uv.lock 과 함께.
RUN uv pip install --system "open-kknaks==2.1.2"

# codex 의 cwd — **빈 git 저장소**. `codex exec` 는 git 저장소 밖에서 `--skip-git-repo-check` 없이 뜨지 않는데 그 플래그는
# back 의 옵션 빌더(integrations/agent.py) 몫이라 여기서 대신하지 않는다. 회의 배치는 파일을 읽지도 쓰지도 않는다
# (system/README.md 「worker — 파일을 쓰지 않는다」) — 출력 스키마는 compose 가 `/app` 에 ro 로 얹는다.
RUN mkdir -p /work && git -C /work init -q

# codex 의 세션·설정·인증 루트. compose 가 이 경로를 명명 볼륨으로 잡고(세션 영속 — DEC-003 §STT 「한 세션 유지」) 인증 파일을 그 아래에 얹는다.
ENV CODEX_HOME=/root/.codex

# 기동 파라미터 — compose environment 로 덮는다. back 의 REDIS_URL · AI_NAMESPACE · AI_QUEUE 와 **같은 값**이어야 한다(BE §11).
ENV REDIS_URL=redis://redis:6379/0 \
    AI_NAMESPACE=task-management \
    AI_QUEUE=default \
    AI_CWD=/work \
    CONCURRENCY=1

WORKDIR /work

CMD ["sh", "-c", "exec open-kknaks worker run --broker \"$REDIS_URL\" --namespace \"$AI_NAMESPACE\" --queues \"$AI_QUEUE\" --work-dir \"$AI_CWD\" --concurrency \"$CONCURRENCY\""]
